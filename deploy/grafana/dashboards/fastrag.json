{
  "title": "FastRAG Operations",
  "uid": "fastrag-ops",
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "p95 TTFT",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(fastrag_time_to_first_answer_chunk_seconds_bucket[5m])))"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Query outcomes",
      "targets": [{"expr": "sum by (outcome, cache_status) (rate(fastrag_queries_total[5m]))"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Stage latency p95",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (stage, le) (rate(fastrag_stage_duration_seconds_bucket[5m])))"}],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}
    }
  ]
}
