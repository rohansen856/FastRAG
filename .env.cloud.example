# FastRAG — cloud profile.
#
# Every dependency is a hosted free tier, so the API fits Render's free web
# service (512 MB RAM, 0.1 CPU) with nothing to self-host. Sign-up links are
# next to each key; none of them ask for a card.
#
#   cp .env.cloud.example .env
#   python scripts/ingest-msmarco.py     # one-off, from your machine
#   python -m fastrag.calibrate
#
# Latency here is dominated by hops to Jina, Groq, and Sarvam, so it will not
# hit 200ms. Use .env.local.example for the benchmark rig; see docs/latency.md.

FASTRAG_PROFILE=cloud
FASTRAG_ENVIRONMENT=production
FASTRAG_RELEASE=cloud

# API auth. Generate both:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FASTRAG_QUERY_API_KEY=
FASTRAG_ADMIN_API_KEY=

# --- Vector DB: Qdrant Cloud free (1 GB, permanent) --------------------------
# https://cloud.qdrant.io — create a cluster, then copy its URL and API key.
FASTRAG_QDRANT_URL=https://REPLACE-ME.REGION.aws.cloud.qdrant.io
FASTRAG_QDRANT_API_KEY=
FASTRAG_QDRANT_ALIAS=kb_current

# onnxruntime is what fastembed's BM25 pulls in, and it does not fit on the
# free instance alongside everything else. Dense-only costs some recall on
# rare terms; set true on any paid instance to get hybrid RRF back.
FASTRAG_SPARSE_RETRIEVAL_ENABLED=false

# --- Embeddings + reranking: Jina AI (10M free tokens, one key for both) -----
# https://jina.ai/api-dashboard/key-manager
# jina-embeddings-v3 is multilingual at 1024d and covers all five Indic
# languages; the local bge model is English-only and would not.
FASTRAG_JINA_API_KEY=
FASTRAG_EMBEDDING_PROVIDER=jina
FASTRAG_RERANKER_PROVIDER=jina
FASTRAG_JINA_EMBEDDING_MODEL=jina-embeddings-v3
FASTRAG_JINA_EMBEDDING_DIMENSION=1024
FASTRAG_JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual

# --- Speech-to-text: Sarvam Saaras v3 ----------------------------------------
# https://dashboard.sarvam.ai — authenticates with an `api-subscription-key`
# header rather than a bearer token. `translate` returns English text for any
# input language; `transcribe` keeps the source language.
FASTRAG_SARVAM_API_KEY=
FASTRAG_STT_PROVIDER=sarvam
FASTRAG_SARVAM_MODEL=saaras:v3
FASTRAG_SARVAM_MODE=transcribe

# Optional second transcriber: https://elevenlabs.io/app/settings/api-keys
# FASTRAG_STT_PROVIDER=elevenlabs
# FASTRAG_ELEVENLABS_API_KEY=

# --- LLM: Groq free (OpenAI-compatible) --------------------------------------
# https://console.groq.com/keys — free tier is 30 requests/minute, so the
# harness retries 429s with backoff and honours Retry-After.
FASTRAG_LLM_BASE_URL=https://api.groq.com/openai/v1
FASTRAG_LLM_API_KEY=
FASTRAG_LLM_MODEL=llama-3.3-70b-versatile

# Fallback provider, used only after the primary exhausts its retries. The
# switch is traced and returned in the response, never silent.
# https://openrouter.ai/keys
FASTRAG_LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
FASTRAG_LLM_FALLBACK_API_KEY=
FASTRAG_LLM_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Registry: Neon free Postgres (0.5 GB, permanent) ------------------------
# https://neon.tech — Render's own free Postgres self-deletes after 30 days,
# which is why it is not used here.
FASTRAG_DATABASE_URL=postgresql://USER:PASSWORD@ep-REPLACE-ME.REGION.aws.neon.tech/fastrag?sslmode=require

# --- Cache: Redis Cloud free (30 MB, includes RediSearch) --------------------
# https://redis.io/try-free
FASTRAG_REDIS_URL=redis://default:PASSWORD@REPLACE-ME.REGION.ec2.redns.redis-cloud.com:PORT
# Semantic cache needs the RediSearch module. Redis Cloud has it; Upstash does
# not support FT.CREATE, so set this false there and exact matching still works.
FASTRAG_SEMANTIC_CACHE_ENABLED=true

# --- Tracing: Langfuse Cloud free (50K units/month) --------------------------
# https://cloud.langfuse.com
FASTRAG_LANGFUSE_PUBLIC_KEY=
FASTRAG_LANGFUSE_SECRET_KEY=
FASTRAG_LANGFUSE_BASE_URL=https://cloud.langfuse.com
FASTRAG_TRACE_RAW_CONTENT=false

# --- Retrieval and generation behaviour --------------------------------------
FASTRAG_CHUNK_STRATEGIES=sentence,fixed,sentence_window,semantic,hierarchical,metadata_aware
FASTRAG_CHUNK_SIZE=400
FASTRAG_CHUNK_OVERLAP=50
FASTRAG_CRAG_ENABLED=true
FASTRAG_GUARDRAILS_ENABLED=true
FASTRAG_GUARDRAIL_LANGUAGES=en,hi,bn,ta,te,mr

# Hosted hops are slower than local ones, so the per-request budget is wider
# than the local profile's and the harness retries more patiently.
FASTRAG_REQUEST_DEADLINE_SECONDS=25
FASTRAG_RETRY_MAX_ATTEMPTS=3

# Your Vercel deployment, so the browser may call the API directly. The
# web/app/api/rag proxy route is the safer default and needs no CORS entry.
FASTRAG_CORS_ORIGINS=https://REPLACE-ME.vercel.app
