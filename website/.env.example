# Base URL of the FastRAG API.
FASTRAG_API_URL=http://localhost:8000

# Query token from FASTRAG_QUERY_API_KEY on the API. Server-only - do NOT use NEXT_PUBLIC_.
FASTRAG_QUERY_TOKEN=change-me-query

# Public site settings (inlined at build time; not secrets). Leave a value empty to hide
# what depends on it.
# Repository link: the header star button, footer and CTA links, and docs links to repo files.
NEXT_PUBLIC_GITHUB_REPO_URL=
# Branch for links to files in the repository (default: master).
# NEXT_PUBLIC_GITHUB_REPO_BRANCH=master
# The developer shown in the Developer section and footer, as one line of JSON. Only "name" is
# required; "photo" is a path under public/ or an https URL.
# NEXT_PUBLIC_DEVELOPER={"name":"Rohan Sen","role":"Builder","bio":"","photo":"/developers/rohan.png","github":"https://github.com/rohansen856","linkedin":"https://www.linkedin.com/in/rohansen856","website":"https://rcsen.vercel.app","email":"rohansen856@gmail.com"}
NEXT_PUBLIC_DEVELOPER=
