# Base URL of the FastRAG API. Locally this is the uvicorn/compose service;
# in production it is the Render web service URL.
FASTRAG_API_URL=http://localhost:8000

# Query token from FASTRAG_QUERY_API_KEY on the API.
# This is read server-side only and is never sent to the browser: all calls go
# through the /api/rag proxy route. Do NOT prefix it with NEXT_PUBLIC_.
FASTRAG_QUERY_TOKEN=change-me-query
