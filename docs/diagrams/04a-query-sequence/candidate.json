  "cards": [
    {
      "dot": "emerald",
      "title": "Happy path shown",
      "items": [
        "Cache miss, CRAG grade 'correct', answer streamed sentence by sentence",
        "Short-circuits: exact or semantic hit returns the cached answer; guardrail refusals and abstentions stream one fixed sentence"
      ]
    },
    {
      "dot": "violet",
      "title": "Profile differences",
      "items": [
        "/v1/voice/query/stream first sends the audio to Sarvam speech-to-text and emits a transcript event, then runs this same pipeline",
        "Local profile embeds and reranks in-process (FastEmbed ONNX) instead of calling Jina",
        "OpenRouter takes over only if Groq fails before emitting a token"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure contract",
      "items": [
        "Registry, embedding, retrieval, rerank and generation failures → SSE error event (HTTP 503 on /v1/query)",
        "Cache failures fail open"
      ]
    }
  ]
