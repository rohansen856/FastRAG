  "cards": [
    {
      "dot": "emerald",
      "title": "What the scope changes",
      "items": [
        "Exact and semantic caches are skipped, so a deleted document can't be answered from cache",
        "The off-topic guardrail is skipped and CRAG never abstains while chunks rank; answers cite the upload"
      ]
    },
    {
      "dot": "amber",
      "title": "Isolation",
      "items": [
        "Unscoped queries filter out session_upload points, so uploads never surface in corpus answers",
        "Uploads live in the active collection; there is no TTL, and an alias switch leaves them behind in the old collection"
      ]
    }
  ]
