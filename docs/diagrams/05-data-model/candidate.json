  "cards": [
    {
      "dot": "violet",
      "title": "index_manifests (Postgres, the only table)",
      "items": [
        "index_version TEXT PK · collection_name TEXT · content_version TEXT · embedding_fingerprint TEXT",
        "state TEXT CHECK (building, validated, active, retired, failed) · manifest JSONB · created_at · activated_at",
        "Partial unique index one_active_index: at most one active row. No foreign keys anywhere"
      ]
    },
    {
      "dot": "cyan",
      "title": "Chunk point payload (Qdrant)",
      "items": [
        "chunk_id · document_id · title · source_uri · page · text · strategy · language · position",
        "Optional raw_text, context_text, strategy metadata (window, parent_id, header), session_upload",
        "Keyword indexes: strategy, language, document_id; bool index: session_upload"
      ]
    },
    {
      "dot": "amber",
      "title": "Logical links, not constraints",
      "items": [
        "No foreign keys: every relation is kept by code, so golden relevant_chunk_ids can go stale after a rebuild (derive-eval checks for that drift)",
        "Cache namespace = sha256 of content_version, embedding fingerprint, prompt_version, model, max_tokens, locale, strategy, document scope",
        "Cached payload = answer · citations[] · outcome; 7-day TTL"
      ]
    }
  ]
