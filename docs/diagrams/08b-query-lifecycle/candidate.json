  "cards": [
    {
      "dot": "emerald",
      "title": "CRAG bands (calibrated)",
      "items": [
        "top ≥ crag_upper → correct: context passes unchanged",
        "reranker_threshold ≤ top < crag_upper → ambiguous: strips scored and refined, never abstains",
        "top < reranker_threshold → incorrect: one LLM rewrite; a passing retry continues to generation"
      ]
    },
    {
      "dot": "rose",
      "title": "Refusal and failure paths",
      "items": [
        "refused: prompt-injection, unsafe or unsupported-language text rules, or the off-topic centroid check after embedding",
        "Unavailable: any required stage (registry, embedding, retrieval, rerank, generation) raising PipelineUnavailable",
        "Uploaded-document scope skips the caches and off-topic check and never abstains while chunks rank"
      ]
    }
  ]
